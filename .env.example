# Core
APP_ENV=development
DEFAULT_LOCALE=tr
HTTP_ADDR=:8080
DATABASE_URL=postgres://home_app:home_app@localhost:5432/home_app?sslmode=disable

# Client/API security. Use long random production values; BFF_SECRETS supports
# comma-separated current,previous values during rotation.
BFF_SECRETS=development-only-change-me
ACCESS_TOKEN_SECRET=development-access-secret-at-least-32-bytes
OTP_HASH_SECRET=development-otp-secret-at-least-32-bytes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Email authentication
OTP_TTL=10m
OTP_MAX_ATTEMPTS=5
OTP_EMAIL_REQUEST_LIMIT=3
OTP_IP_REQUEST_LIMIT=10
OTP_VISITOR_REQUEST_LIMIT=5
# Configure both App Review values together, or leave both empty to disable it.
APP_REVIEW_EMAIL=app-review@bosagezme.com
APP_REVIEW_CODE=123456

# Google identity, Places and OpenAI search
GOOGLE_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=3s

# Email delivery. Production uses EMAIL_PROVIDER=gmail. With Gmail, EMAIL_FROM
# must resolve to the same mailbox as GMAIL_IMPERSONATED_USER. Configure exactly
# one of GMAIL_SERVICE_ACCOUNT_FILE or GMAIL_SERVICE_ACCOUNT_JSON.
EMAIL_PROVIDER=development
EMAIL_FROM="Boşa Gezme! <no-reply@bosagezme.com>"
EMAIL_DEVELOPMENT_DIR=.data/mailbox
GMAIL_IMPERSONATED_USER=no-reply@bosagezme.com
GMAIL_SERVICE_ACCOUNT_FILE=
GMAIL_SERVICE_ACCOUNT_JSON=
GMAIL_API_URL=
# Optional provider-smoke recipient; do not leave set after verification.
GMAIL_TEST_RECIPIENT=

# Resend remains an alternative provider and is not needed when Gmail is used.
EMAIL_API_URL=
EMAIL_API_KEY=
RESEND_API_KEY=
RESEND_TEST_RECIPIENT=

# Object storage. Production uses OBJECT_STORAGE_PROVIDER=gcs with Application
# Default Credentials / Workload Identity; no static access key is required.
OBJECT_STORAGE_PROVIDER=development
OBJECT_STORAGE_BUCKET=bosagezme-dev
GCS_SIGNING_SERVICE_ACCOUNT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PATH_STYLE=true
OBJECT_STORAGE_UPLOAD_TTL=15m
OBJECT_STORAGE_LOCAL_DIR=.data/uploads
OBJECT_STORAGE_PUBLIC_URL=http://localhost:8080/uploads
MEDIA_MAX_BYTES=10485760
# Optional provider-smoke bucket; it must be safe for a temporary test object.
GCS_TEST_BUCKET=

# Location verification and privacy
STORE_REVIEW_RADIUS_METERS=500
STORE_LOCATION_MAX_ACCURACY_METERS=100
STORE_VISIT_PROOF_TTL=720h
SEARCH_LOCATION_DECIMALS=3
SEARCH_RETENTION_DAYS=365
SEARCH_LOCATION_RETENTION_DAYS=30
VISITOR_RETENTION_DAYS=180

# Reporting and operations
REPORTING_TIMEZONE=Europe/Istanbul
SEARCH_ATTRIBUTION_WINDOW_HOURS=72
METRICS_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Integration tests only; never point this at production.
TEST_DATABASE_URL=
