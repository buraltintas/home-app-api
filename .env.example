# Boşa Gezme! production environment

# Runtime and database
APP_ENV=production
# Quote this value in shell-loaded .env files when it contains characters such
# as `&`; managed production platforms should inject it as a native variable.
DATABASE_URL=

# Generate three different, long random secrets. BFF_SECRETS may temporarily
# contain current,previous during a rotation.
BFF_SECRETS=
ACCESS_TOKEN_SECRET=
OTP_HASH_SECRET=

# App Store review login. Both values must be configured together.
APP_REVIEW_EMAIL=app-review@bosagezme.com
APP_REVIEW_CODE=123456

# Google login, store discovery and natural-language search
GOOGLE_CLIENT_ID=
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=

# Google Workspace Gmail delivery. Mount the service-account JSON as a secret
# file; its delegated sender must match EMAIL_FROM.
EMAIL_PROVIDER=gmail
EMAIL_FROM="Boşa Gezme! <no-reply@bosagezme.com>"
GMAIL_IMPERSONATED_USER=no-reply@bosagezme.com
GMAIL_SERVICE_ACCOUNT_FILE=/run/secrets/gmail-service-account.json

# Google Cloud Storage. The runtime service account uses ADC / Workload
# Identity and needs bucket access plus IAM signing permission.
OBJECT_STORAGE_PROVIDER=gcs
OBJECT_STORAGE_BUCKET=

# Visit verification. Device accuracy is added to the measured store distance,
# so accepting a coarser reading does not expand the configured review radius.
STORE_REVIEW_RADIUS_METERS=2000
STORE_LOCATION_MAX_ACCURACY_METERS=1000
STORE_VISIT_PROOF_TTL=720h

# Protect the internal metrics endpoint with a separate random token.
METRICS_TOKEN=

# Comma-separated addresses permitted to use /v1/admin. Leaving this empty closes the
# admin surface completely rather than leaving it open, so a deployment that forgets it
# fails safe. Administration reuses the ordinary email sign-in; this only decides who is
# authorised once signed in.
ADMIN_EMAILS=

# Local-first search. Off by default: while this is false the provider is asked on every
# search, exactly as it was before the sufficiency gate existed. Turning it on makes the
# provider a fallback -- asked only when our own catalogue cannot answer the question.
SEARCH_LOCAL_FIRST_ENABLED=false

# The gate's thresholds. Every one of these has a default in the code, so a deployment
# that sets none of them still works; they live here because the right values are not
# knowable in advance and are meant to move as the shadow measurements come in.
# SEARCH_GATE_MIN_RESULTS=8
# SEARCH_GATE_MIN_RELEVANCE=0.6
# SEARCH_GATE_RELEVANCE_SAMPLE=5
# SEARCH_GATE_MIN_COVERAGE=40
# SEARCH_GATE_COVERAGE_RADIUS_METERS=15000

# Fraction of local-only searches asked of the provider afterwards, off the request path,
# purely to measure what staying local cost. A shadow call costs what a real one costs, so
# this stays small; the code refuses anything above 0.5.
# SEARCH_SHADOW_RATE=0.05
